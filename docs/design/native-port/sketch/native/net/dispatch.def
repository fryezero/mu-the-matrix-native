/* native/net/dispatch.def (sketch): THE route table - the client's receive routing as data.
 *
 * Generated by scripts/gen_dispatch.py from the restored text (jump table 0x0128e59d behind
 * 0x01287ead, plus every sub-dispatcher), checked in, and re-verified by validate_dispatch.py:
 * 0x01287ead runs under Unicorn with every handler stubbed, over all opcodes, sub bytes and both
 * head families, and the stub reached must equal the row (planted mistakes: a swapped row, a
 * dropped family offset, a wrong head family). Addresses and numbers only; no client bytes.
 *
 * Until NET-DISPATCH-001 runs the generator, rows are seeded from the static readings already in
 * the findings and tagged MU_STATIC (read from disassembly) or MU_UNKNOWN (route expected, address
 * not recovered). The generator replaces every seeded row with a MU_VERIFIED one.
 *
 *   MU_FAMILY(opcode, c1_at, c2_at, client_subdispatcher)   sub byte offset per head family
 *   MU_ROUTE(opcode, sub, client_handler, evidence)          one case the original reaches
 *
 * Native code never edits this file by hand after generation. It binds to a route with one
 * MU_OP(opcode, sub, apply) row in native/session/ops/<domain>.ops. The build fails when an
 * MU_OP names a route this table lacks, or two MU_OP rows bind one route. A route with no MU_OP
 * and no MU_IGNORE row (ignore.def) is an unbound route: the journal counts every frame that
 * hits one, `--coverage FILE` lists them by client address, and `--strict` makes them fatal.
 */
MU_FAMILY(0xF4, MU_AT_UNKNOWN, 4, 0x012883f0u)   /* sub-dispatch by packet[4] (static); C1 offset TODO */
MU_FAMILY(0xF1, 3, MU_AT_UNKNOWN, 0x0128b24du)   /* sub-dispatch by packet[3] (static) */
MU_FAMILY(0xA0, 3, 4, 0x0128805cu)   /* skill_list.h:7-8 (static) */
MU_FAMILY(0x55, 3, 4, MU_ADDR_UNVERIFIED)
MU_FAMILY(0xE7, 3, 4, MU_ADDR_UNVERIFIED)
MU_FAMILY(0xF6, 3, 4, MU_ADDR_UNVERIFIED)

MU_ROUTE(0xF4, 0x03, 0x0127ea69u, MU_STATIC)
