/* RENDER-ITEMS-002Q: owner-effect programs of item bodies (item_owner_fx.h, generated by
 * scripts/gen_item_owner_fx.py from the pinned instructions). The armour bodies 0x1bc3..0x1c78 and five helm
 * bodies end their RenderPartObjectBody case with an effect block: owner-bone positions 0x012b678d, CreateSprite
 * 0x01692eb7 and CreateParticle 0x0168fafd requests, rand() % m gates, quantised randoms 0x011ff622 and the vec3
 * helpers 0x00cfcad8 (subtract), 0x00cfca74 (add), 0x00cfd0cc (normalize). Included at the end of renderchar.c;
 * emit_parameter_body runs a program after the type's base body draws, only through mu_rc_item_draws_owner.
 *
 * RENDER-ITEMS-002R: pre-draw programs. RenderObjDraw's own type case creates bone sprites 0x0150e746 and
 * TransformPosition 0x012b6ef1 positions on the item's own posed bones (BoneTransform 0x06fce398, often by name
 * through 0x012bd35a), with clock, alpha, sine and rand() values, before the body draws. mu_rc_item_draws_owner
 * runs them first when the host has item_transform. A request whose item bone is outside 0..item_bones-1 (the
 * client reads another matrix) is passed to host->refuse instead of host->emit, as is every request computed
 * from such a position.
 *
 * RENDER-ITEMS-002S: integer registers (int32 bits in a register: cvttss2si, cvtsi2ss, idiv, rand(), the item
 * bone count), forward branches on runtime values (op 34, x86 flag semantics) with joins (op 35 jumps over the
 * other path's moves), the light argument, the OBJECT position, CreateJoint 0x0153b02c and CreateSprite with a
 * rotation. The register file grows to 4096 (the reader's REGISTERS).
 *
 * RENDER-ITEMS-002T: the rendered-frame counter [0x0bdc5ebc] (op 42), 0x012b678d on an item bone with a NULL
 * local point (op 43), the random spherical vector 0x00d01fc6 (op 44), array elements at a bounded runtime index
 * (op 45: rand() % 3 selects a bone or a value) and CreateParticle with a register bitmap and argument 8 (ops 46,
 * 47). Post programs (owner-table rows in mu_rc_fx_post_types): a register bitmap for the next request (op 48)
 * and TransformPosition 0x012b6ef1 on the OBJECT's own bone k (op 49). */

static int owner_fx_index(int32_t type)
{
    size_t low = 0, high = sizeof mu_rc_fx_types / sizeof mu_rc_fx_types[0];
    while (low < high) {
        size_t mid = low + (high - low) / 2;
        if (mu_rc_fx_types[mid].type < type)
            low = mid + 1;
        else if (mu_rc_fx_types[mid].type > type)
            high = mid;
        else
            return (int)mid;
    }
    return -1;
}

int mu_rc_item_post_fx(int32_t type)
{
    for (size_t i = 0; i < sizeof mu_rc_fx_post_types / sizeof mu_rc_fx_post_types[0]; ++i)
        if (type >= 0 && mu_rc_fx_post_types[i] == type)
            return 1;
    return 0;
}

int mu_rc_item_owner_fx(int32_t type)
{
    int i = owner_fx_index(type);
    return i < 0 ? 0 : mu_rc_fx_types[i].max_bone + 1;
}

static float fx_float(uint32_t bits)
{
    float x;
    memcpy(&x, &bits, 4);
    return x;
}

/* cvttss2si: the integer indefinite for NaN and out-of-range values. */
static int32_t fx_trunc(float x)
{
    return x >= -2147483648.0f && x < 2147483648.0f ? (int32_t)x : INT32_MIN;
}

/* 0x011ff622(lo, hi, steps): steps as an unsigned value converted through binary64, both bounds truncated
 * after a binary32 product, one rand() (0x011ff68d), the quotient in binary32, then the two clamps in order. */
static float fx_range(const mu_rc_owner_host *h, float lo, float hi, uint32_t steps)
{
    const float s = (float)(double)steps;
    const int32_t a = fx_trunc(s * lo), b = fx_trunc(s * hi);
    const int32_t n = (int32_t)((uint32_t)b - (uint32_t)a + 1u);
    const int32_t r = owner_random(h);
    /* The generated programs have constant bounds with n > 0 (checked by the generator). */
    float v = (float)(int32_t)((uint32_t)(n ? r % n : 0) + (uint32_t)a) / s;
    if (lo > v)
        v = lo;
    if (v > hi)
        v = hi;
    return v;
}

/* 0x00cfd15f(v, v): length 0x00cfd020 = (float)sqrt((double)((x*x + y*y) + z*z)); |length| < 1e-6 gives the
 * zero vector (0x00a72592, 0x00cfcf7b), otherwise each component times 1/length (0x00cfcb3c). */
static void fx_normalize(const float in[3], float out[3])
{
    const float squares = in[0] * in[0] + in[1] * in[1] + in[2] * in[2];
    const float length = (float)sqrt((double)squares);
    if (1e-6f > length && length > -1e-6f) {
        out[0] = out[1] = out[2] = 0.0f;
        return;
    }
    const float inverse = 1.0f / length;
    for (int k = 0; k < 3; ++k)
        out[k] = in[k] * inverse;
}

/* 0x00d01fc6(out, r max, r min, theta max, theta min, phi max, phi min): each comparison is comiss (false when
 * unordered), the three randoms are 0x011ff622 calls; returns the radius (fldz on the early exit). */
static float fx_random_vector(const mu_rc_owner_host *h, const float a[6], float out[3])
{
    float rmax = a[0], rmin = a[1], tmax = a[2], tmin = a[3], pmax = a[4], pmin = a[5];
    const float floor_radius = 9.9999997e-07f /* 0x01a80990 */, radians = 0.017453292f /* 0x01a7fd6c */;
    if (0.0f > rmin)
        rmin = 0.0f;
    const float r = rmin >= rmax ? rmin : fx_range(h, rmin, rmax, 50);
    if (floor_radius > r) {
        out[0] = out[1] = out[2] = 0.0f;
        return 0.0f;
    }
    if (tmin > tmax)
        tmin = tmax;
    if (0.0f > tmin)
        tmin = 0.0f;
    if (tmax > 180.0f)
        tmax = 180.0f;
    const float theta = fx_range(h, tmin * radians, tmax * radians, 100);
    if (pmin > pmax)
        pmin = pmax;
    if (0.0f > pmin)
        pmin = 0.0f;
    if (pmax > 360.0f)
        pmax = 360.0f;
    const float phi = fx_range(h, pmin * radians, pmax * radians, 100);
    const float x = client_sin(theta) * r;
    out[0] = x * (float)cos((double)phi);     /* 0x009fa223: the CRT cos of a binary32, rounded to binary32 */
    const float y = client_sin(theta) * r;
    out[1] = y * client_sin(phi);
    out[2] = (float)cos((double)theta) * r;
    return r;
}

static int pre_fx_index(int32_t type)
{
    size_t low = 0, high = sizeof mu_rc_fx_pre_types / sizeof mu_rc_fx_pre_types[0];
    while (low < high) {
        size_t mid = low + (high - low) / 2;
        if (mu_rc_fx_pre_types[mid].type < type)
            low = mid + 1;
        else if (mu_rc_fx_pre_types[mid].type > type)
            high = mid;
        else
            return type < 0 ? -1 : (int)mid;
    }
    return -1;
}

int mu_rc_item_pre_fx(int32_t type)
{
    return pre_fx_index(type) >= 0;
}

static int32_t fx_int(const float *r)
{
    int32_t v;
    memcpy(&v, r, 4);
    return v;
}

static void fx_set_int(float *r, int32_t v)
{
    memcpy(r, &v, 4);
}

/* Op 34: the jcc after cmp (integer) or comiss/ucomiss (float: unordered sets ZF, PF and CF). Conditions 10/11
 * are the lahf; test ah, 0x44; jp/jnp idiom: jp is taken unless the operands are ordered and equal. */
static int fx_condition(const float *x, const float *y, uint8_t e)
{
    const int cc = e & 15;
    int zf, cf, sf_of_lt;
    if (e & 0x10) {
        const int unordered = isnan(*x) || isnan(*y);
        zf = unordered || *x == *y;
        cf = unordered || *x < *y;
        if (cc == 10)
            return unordered || *x != *y;
        if (cc == 11)
            return !unordered && *x == *y;
        sf_of_lt = 0;
    } else {
        const int32_t a = fx_int(x), b = fx_int(y);
        zf = a == b;
        cf = (uint32_t)a < (uint32_t)b;
        sf_of_lt = a < b;
    }
    switch (cc) {
    case 0: return zf;
    case 1: return !zf;
    case 2: return sf_of_lt;
    case 3: return !sf_of_lt;
    case 4: return !zf && !sf_of_lt;
    case 5: return zf || sf_of_lt;
    case 6: return cf;
    case 7: return !cf;
    case 8: return !cf && !zf;
    default: return cf || zf;
    }
}

#define MU_RC_FX_REGISTERS 4096

/* One program. bad[] marks registers computed from an item position outside the bone domain (or an idiv
 * fault); a branch on such a value marks every later request refused (lost). */
static void run_fx(const mu_rc_fx_op *ops, int count, int regs, const mu_rc_item *it, const mu_rc_owner_host *h)
{
    static const float zero[3] = {0.0f, 0.0f, 0.0f};
    float r[MU_RC_FX_REGISTERS];
    uint8_t bad[MU_RC_FX_REGISTERS];
    int lost = 0;
    int32_t next_bitmap = 0;
    int has_bitmap = 0;
    uint8_t bitmap_bad = 0;
    if (regs > MU_RC_FX_REGISTERS)
        return;
    memset(r, 0, (size_t)regs * sizeof r[0]);
    memset(bad, 0, (size_t)regs);
    for (int pc = 0; pc < count;) {
        const mu_rc_fx_op *o = &ops[pc++];
        mu_rc_owner_fx fx;
        int32_t bone;
        switch (o->op) {
        case 1:
            memcpy(&r[o->a], &o->k, 4);
            bad[o->a] = 0;
            break;
        case 2:
            r[o->a] = r[o->b];
            bad[o->a] = bad[o->b];
            break;
        case 3:
            r[o->a] = r[o->b] * r[o->c];
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        case 4:
            r[o->a] = r[o->b] + r[o->c];
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        case 5:
            r[o->a] = r[o->b] - r[o->c];
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        case 6:
            r[o->a] = r[o->b] / r[o->c];
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        case 7: {
            uint32_t w;
            memcpy(&w, &r[o->b], 4);
            w ^= 0x80000000u;
            memcpy(&r[o->a], &w, 4);
            bad[o->a] = bad[o->b];
            break;
        }
        case 8:
            if (owner_random(h) % (int32_t)o->a != 0)
                pc = (int)o->k;
            break;
        case 9:
            r[o->a] = fx_range(h, r[o->b], r[o->c], o->k);
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        case 10:
            h->transform(h->context, (int32_t)o->k, &r[o->b], &r[o->a]);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = bad[o->b] | bad[o->b + 1] | bad[o->b + 2];
            break;
        case 11:
            fx_normalize(&r[o->b], &r[o->a]);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = bad[o->b] | bad[o->b + 1] | bad[o->b + 2];
            break;
        case 12:
            memcpy(&r[o->a], h->angle, sizeof h->angle);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 0;
            break;
        case 15:   /* 0x0185bdc4(k, 0) */
            r[o->a] = client_wave(fx_float(o->k), it->time);
            bad[o->a] = 0;
            break;
        case 16:   /* 0x012bd35a(name, -1) on the item model */
            bone = h->bone_named ? h->bone_named(h->context, mu_rc_fx_names[o->k]) : -1;
            memcpy(&r[o->a], &bone, 4);
            bad[o->a] = 0;
            break;
        case 18:   /* TestFrustrum2D flag clear: the case is skipped */
            if (!h->visible)
                pc = count;   /* k: the program end */
            break;
        case 19:
            r[o->a] = it->alpha;
            bad[o->a] = 0;
            break;
        case 20:
            r[o->a] = it->time;
            bad[o->a] = 0;
            break;
        case 21:
            r[o->a] = client_sin(r[o->b]);
            bad[o->a] = bad[o->b];
            break;
        case 22: { /* 0x0184f8ff: 0 > x ? -x (xorps sign) : x */
            uint32_t w;
            memcpy(&w, &r[o->b], 4);
            if (0.0f > r[o->b])
                w ^= 0x80000000u;
            memcpy(&r[o->a], &w, 4);
            bad[o->a] = bad[o->b];
            break;
        }
        case 23:   /* cdq/idiv then cvtsi2ss */
            r[o->a] = (float)(owner_random(h) % (int32_t)o->k);
            bad[o->a] = 0;
            break;
        case 24:   /* TransformPosition 0x012b6ef1 on the item's own bone */
            bone = fx_int(&r[o->b]);
            if (bad[o->b] || bone < 0 || bone >= h->item_bones || !h->item_transform) {
                r[o->a] = r[o->a + 1] = r[o->a + 2] = 0.0f;
                bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 1;
                break;
            }
            h->item_transform(h->context, bone, &r[o->c], (int32_t)o->k, &r[o->a]);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = bad[o->c] | bad[o->c + 1] | bad[o->c + 2];
            break;
        case 26:   /* cvttss2si */
            fx_set_int(&r[o->a], fx_trunc(r[o->b]));
            bad[o->a] = bad[o->b];
            break;
        case 27:   /* cvtsi2ss */
            r[o->a] = (float)fx_int(&r[o->b]);
            bad[o->a] = bad[o->b];
            break;
        case 28:   /* idiv: remainder, quotient (a zero divisor or INT32_MIN / -1 faults in the client) */
        case 29: {
            const int32_t x = fx_int(&r[o->b]), y = fx_int(&r[o->c]);
            const int fault = y == 0 || (x == INT32_MIN && y == -1);
            fx_set_int(&r[o->a], fault ? 0 : o->op == 28 ? x % y : x / y);
            bad[o->a] = (uint8_t)(bad[o->b] | bad[o->c] | fault);
            break;
        }
        case 30:
        case 31:
        case 32: {
            const uint32_t x = (uint32_t)fx_int(&r[o->b]), y = (uint32_t)fx_int(&r[o->c]);
            fx_set_int(&r[o->a], (int32_t)(o->op == 30 ? x + y : o->op == 31 ? x - y : x * y));
            bad[o->a] = bad[o->b] | bad[o->c];
            break;
        }
        case 33:   /* rand() as an integer */
            fx_set_int(&r[o->a], owner_random(h));
            bad[o->a] = 0;
            break;
        case 34:
            lost |= bad[o->a] | bad[o->b];
            if (fx_condition(&r[o->a], &r[o->b], o->e))
                pc = (int)o->k;
            break;
        case 35:
            pc = (int)o->k;
            break;
        case 36:   /* the item model's bone count (+0x22) */
            fx_set_int(&r[o->a], h->item_bones);
            bad[o->a] = 0;
            break;
        case 37:   /* RenderObjDraw's light argument */
            memcpy(&r[o->a], it->light, sizeof it->light);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 0;
            break;
        case 38:   /* OBJECT +0x158 */
            memcpy(&r[o->a], h->position, sizeof h->position);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 0;
            break;
        case 41: { /* div: unsigned remainder */
            const uint32_t x = (uint32_t)fx_int(&r[o->b]), y = (uint32_t)fx_int(&r[o->c]);
            fx_set_int(&r[o->a], (int32_t)(y ? x % y : 0));
            bad[o->a] = (uint8_t)(bad[o->b] | bad[o->c] | !y);
            break;
        }
        case 42:   /* the rendered-frame counter [0x0bdc5ebc] (unsigned) */
            fx_set_int(&r[o->a], (int32_t)h->frame);
            bad[o->a] = !h->frame_known;
            break;
        case 43:   /* 0x012b678d(out, OBJECT, item bone r[b], NULL); the client leaves out unchanged outside 0..+0x22 */
            bone = fx_int(&r[o->b]);
            if (bad[o->b] || bone < 0 || bone >= h->item_bones || !h->object_transform) {
                r[o->a] = r[o->a + 1] = r[o->a + 2] = 0.0f;
                bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 1;
                break;
            }
            h->object_transform(h->context, bone, &r[o->a]);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 0;
            break;
        case 44: { /* 0x00d01fc6(out r[a..a+2], arguments r[b..b+5]); r[a+3] = its x87 result */
            r[o->a + 3] = fx_random_vector(h, &r[o->b], &r[o->a]);
            uint8_t any = 0;
            for (int k = 0; k < 6; ++k)
                any |= bad[o->b + k];
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = bad[o->a + 3] = any;
            break;
        }
        case 45: { /* r[a] = word r[b] / 4 of the table r[c..c+d-1] (r[b] is a byte offset) */
            const int32_t off = fx_int(&r[o->b]);
            if (bad[o->b] || off < 0 || off % 4 || off / 4 >= (int32_t)o->d) {
                r[o->a] = 0.0f;
                bad[o->a] = 1;
                break;
            }
            r[o->a] = r[o->c + off / 4];
            bad[o->a] = bad[o->c + off / 4];
            break;
        }
        case 48:   /* the next request's bitmap is r[a] */
            next_bitmap = fx_int(&r[o->a]);
            bitmap_bad = bad[o->a];
            has_bitmap = 1;
            break;
        case 49:   /* 0x012b6ef1(OBJECT bone k matrix via 0x0129f12c, local r[c..c+2], out r[a..a+2], translate e) */
            if (!h->owner_item_transform || (int32_t)o->k >= h->bones) {
                r[o->a] = r[o->a + 1] = r[o->a + 2] = 0.0f;
                bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = 1;
                break;
            }
            h->owner_item_transform(h->context, (int32_t)o->k, &r[o->c], (int32_t)o->e, &r[o->a]);
            bad[o->a] = bad[o->a + 1] = bad[o->a + 2] = bad[o->c] | bad[o->c + 1] | bad[o->c + 2];
            break;
        case 39: { /* CreateJoint 0x0153b02c(bitmap k, pos r[a], target r[b], angle r[c], subtype e, OBJECT, scale r[d],
                    * -1, 0, 0, -1, 0, -1, 0) */
            memset(&fx, 0, sizeof fx);
            fx.kind = MU_RC_OWNER_JOINT;
            fx.bitmap = (int32_t)o->k;
            fx.subtype = (int32_t)o->e;
            fx.owner = 1;
            memcpy(fx.position, &r[o->a], sizeof fx.position);
            memcpy(fx.target, &r[o->b], sizeof fx.target);
            memcpy(fx.angle, &r[o->c], sizeof fx.angle);
            fx.scale = r[o->d];
            const int refused = lost | bad[o->a] | bad[o->a + 1] | bad[o->a + 2] | bad[o->b] | bad[o->b + 1] |
                                bad[o->b + 2] | bad[o->c] | bad[o->c + 1] | bad[o->c + 2] | bad[o->d];
            if (refused) {
                if (h->refuse)
                    h->refuse(h->context, &fx);
            } else if (h->emit) {
                h->emit(h->context, &fx);
            }
            break;
        }
        case 13:
        case 14:
        case 17:
        case 25:
        case 40:
        case 46:
        case 47: {
            int refused = lost;
            memset(&fx, 0, sizeof fx);
            fx.kind = o->op == 13 || o->op == 17 || o->op == 40 ? MU_RC_OWNER_SPRITE : MU_RC_OWNER_PARTICLE;
            fx.bitmap = (int32_t)o->k;
            if (has_bitmap) {
                fx.bitmap = next_bitmap;
                refused |= bitmap_bad;
                has_bitmap = 0;
            }
            if (o->op >= 46) {   /* CreateParticle(bitmap r[k], ..., argument 8 r[k + 1]) */
                fx.bitmap = fx_int(&r[o->k]);
                fx.extra = fx_int(&r[o->k + 1]);
                refused |= bad[o->k] | bad[o->k + 1];
            }
            if (o->op == 17) {
                /* 0x0150e746: TransformPosition(BoneTransform + 0x30 * bone, (0, 0, 0), translate 1), then
                 * CreateSprite(bitmap, position, scale, light, OBJECT, rotation, blend, 4, axes). */
                bone = fx_int(&r[o->a]);
                refused = bad[o->a] || bone < 0 || bone >= h->item_bones || !h->item_transform;
                if (!refused)
                    h->item_transform(h->context, bone, zero, 1, fx.position);
                fx.rotation = r[o->d];
                fx.blend = o->e;
                refused |= bad[o->d];
            } else {
                memcpy(fx.position, &r[o->a], sizeof fx.position);
                refused |= bad[o->a] | bad[o->a + 1] | bad[o->a + 2];
            }
            if (o->op == 40) {   /* CreateSprite(bitmap, pos, scale, light, OBJECT, rotation r[d], blend e, 4, axes) */
                fx.rotation = r[o->d];
                fx.blend = o->e;
                refused |= bad[o->d];
            }
            memcpy(fx.light, &r[o->c], sizeof fx.light);
            refused |= bad[o->c] | bad[o->c + 1] | bad[o->c + 2];
            if (o->op == 13 || o->op == 17 || o->op == 40) {
                fx.scale = r[o->b];
                refused |= bad[o->b];
            } else {
                memcpy(fx.angle, &r[o->b], sizeof fx.angle);
                fx.scale = r[o->d];
                fx.subtype = o->e;
                fx.owner = o->op == 25 || o->op == 47;
                refused |= bad[o->b] | bad[o->b + 1] | bad[o->b + 2] | bad[o->d];
            }
            if (refused) {
                if (h->refuse)
                    h->refuse(h->context, &fx);
            } else if (h->emit) {
                h->emit(h->context, &fx);
            }
            break;
        }
        default:
            return;
        }
    }
}

static void owner_fx(const sink *s, const mu_rc_owner_host *h)
{
    const int index = owner_fx_index(s->item->type);
    if (index < 0)
        return;
    const int32_t need = mu_rc_fx_types[index].max_bone + 1;
    /* Post programs reach the OBJECT's bones through 0x0129f12c only (its model's bone count, h->bones); the part-17
     * programs' 0x012b678d also checks the item model's (+0x22). */
    if (need > h->bones || (need > h->item_bones && !mu_rc_item_post_fx(s->item->type)))
        return;
    run_fx(&mu_rc_fx_ops[mu_rc_fx_types[index].first], mu_rc_fx_types[index].count, mu_rc_fx_types[index].regs,
           s->item, h);
}

static void pre_fx(const mu_rc_item *it, const mu_rc_owner_host *h)
{
    const int index = pre_fx_index(it->type);
    if (index >= 0)
        run_fx(&mu_rc_fx_ops[mu_rc_fx_pre_types[index].first], mu_rc_fx_pre_types[index].count,
               mu_rc_fx_pre_types[index].regs, it, h);
}
