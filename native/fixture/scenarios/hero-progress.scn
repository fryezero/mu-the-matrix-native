# FIXTURE-001: the hero domain's vertical slice. Synthetic, authored here; no game data.
# A seeded Dark Knight (class 0x01) in Lorencia; the progress behaviour answers with C1 frames.
endpoint game 127.0.0.1:55901
use progress class=0x01 level=1 points=0 exp_rate=1 latency=2
join world=0 tile=133,127 angle=0 class=0x01 level=1 name=Fixture slot=0

at 2 progress join                 # 0x55 0x57 (stats) and 0x55 0x94 (speeds)
at 6 client submit add_stat 0      # no free points yet: the client's own refusal, nothing is sent
at 8 progress kill 12              # 0x16 as C1, refused by the client (C1 4D 02 00 16, Send(1, 0)); the server's
                                   # L = 1 + 12 % 40 = 13: (13 + 25) * 13 / 3 = 164 >= 100: A0 06 level 2, 5 points
at 10 progress kill 30             # (31 + 25) * 31 / 3 = 578 >= 340: A0 06 level 3, 10 points
at 20 client submit add_stat 0     # strength +1: C1 05 01 [00 00 after XorData] -> A0 11, 0x55 0x57
at 21 client submit add_stat 1     # throttled: within 100 ms of the previous request (0x00b48aca)
at 30 client submit add_stat 1     # agility +1 -> A0 11, 0x55 0x57, 0x55 0x94
at 31 client submit master_point 0 # the request body is not reconstructed: UNRECOVERED, nothing sent
at 40 progress respawn map=3 x=175 y=112 dir=1 money=1500   # another map: the world-change barrier
at 41 progress levelup             # A0 06 level 4, held behind the barrier until the world is attached
at 46 client attach 3              # the world tool loaded map 3: the held frames apply
at 50 client lease                 # one logic step under the lease (no write)
at 52 client lease write 0x180 7   # a write to the motion zone (the tile): allowed

expect unbound = 0
expect undecodable = 0
expect hero.level = 4
expect hero.points = 13
expect hero.strength = 29
expect hero.agility = 21
expect hero.max_hp > 0
expect money = 1500
expect place.world = 3
expect waiting = -1
expect unsent = 2                  # the two 4D reports wait for the C3 wrap (NET-DECODE-001)
expect unrecovered = 1
expect phase = in_world
