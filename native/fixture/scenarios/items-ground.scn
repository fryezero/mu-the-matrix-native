# Recorded 20/21 routes only. The server pickup command is explicit, since the
# encrypted request is unsent and the inbound pickup-answer route is absent.
endpoint game 127.0.0.1:55906
use items latency=2 despawn=12
join world=0 tile=120,120 class=1 level=10 name=Items slot=0
at 1 client lease tile 121 120
at 2 items drop 1 121 120
at 3 client submit item_pickup 0
at 4 items pickup 0
at 8 items drop 0x1c0f 122 120
at 9 client lease
expect unbound = 0
expect undecodable = 0
expect items.creates = 2
expect items.deletes = 2
expect items.live = 0
expect items.pending = -1
expect unsent = 1
expect fixture.requests = 0
expect unrecovered = 0
