/* CHARACTER fields. Names distinguish the two proven level reads. Record extent STATIC. */
MU_RECORD(CHARACTER, 0x3670, STATIC)
MU_FIELD(CHARACTER, 0x012, 1, u8, REPLICATED, class_byte, STATIC)
MU_FIELD(CHARACTER, 0x023, 1, u8, REPLICATED, dead, STATIC)
MU_FIELD(CHARACTER, 0x03e, 2, i16, REPLICATED, key, STATIC)
MU_FIELD(CHARACTER, 0x044, 32, bytes, REPLICATED, name, STATIC)
MU_FIELD(CHARACTER, 0x144, 2, u16, REPLICATED, scene_level, VERIFIED)
MU_FIELD(CHARACTER, 0x14e, 2, u16, REPLICATED, label_level_14e, VERIFIED)
MU_FIELD(CHARACTER, 0x180, 8, i32, MOTION, tile, STATIC)
MU_FIELD(CHARACTER, 0x3194, 0x48, bytes, MOTION, path, STATIC)
