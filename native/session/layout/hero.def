/* Progress offsets remain STATIC here: only the dedicated layout probes grant VERIFIED.
 * 0x1b50 is the minimum known extent, not a proven allocation size. */
MU_RECORD(CharacterAttribute, 0x1b50, STATIC)
MU_FIELD(CharacterAttribute, 0x000, 4, i32, REPLICATED, level, STATIC)
MU_FIELD(CharacterAttribute, 0x008, 8, u64, REPLICATED, exp, STATIC)
MU_FIELD(CharacterAttribute, 0x010, 8, u64, REPLICATED, next_exp, STATIC)
MU_FIELD(CharacterAttribute, 0x018, 4, i32, REPLICATED, mlevel, STATIC)
MU_FIELD(CharacterAttribute, 0x020, 8, u64, REPLICATED, mexp, STATIC)
MU_FIELD(CharacterAttribute, 0x028, 8, u64, REPLICATED, mnext_exp, STATIC)
MU_FIELD(CharacterAttribute, 0x030, 4, i32, REPLICATED, mpoints, STATIC)
MU_FIELD(CharacterAttribute, 0x034, 4, i32, REPLICATED, m34, STATIC)
MU_FIELD(CharacterAttribute, 0x03c, 4, i32, REPLICATED, m3c, STATIC)
MU_FIELD(CharacterAttribute, 0x040, 16, i32, REPLICATED, mlife_max, STATIC)
MU_FIELD(CharacterAttribute, 0x068, 4, i32, REPLICATED, life, STATIC)
MU_FIELD(CharacterAttribute, 0x06c, 4, i32, REPLICATED, mana, STATIC)
MU_FIELD(CharacterAttribute, 0x070, 4, i32, REPLICATED, life_max, STATIC)
MU_FIELD(CharacterAttribute, 0x074, 4, i32, REPLICATED, mana_max, STATIC)
MU_FIELD(CharacterAttribute, 0x078, 4, i32, REPLICATED, shield, STATIC)
MU_FIELD(CharacterAttribute, 0x07c, 4, i32, REPLICATED, shield_max, STATIC)
MU_FIELD(CharacterAttribute, 0x080, 4, i32, REPLICATED, ag, STATIC)
MU_FIELD(CharacterAttribute, 0x084, 4, i32, REPLICATED, ag_max, STATIC)
MU_FIELD(CharacterAttribute, 0x187, 1, u8, REPLICATED, class, STATIC)
MU_FIELD(CharacterAttribute, 0x18a, 2, u16, REPLICATED, strength, STATIC)
MU_FIELD(CharacterAttribute, 0x18c, 2, u16, REPLICATED, dexterity, STATIC)
MU_FIELD(CharacterAttribute, 0x18e, 2, u16, REPLICATED, vitality, STATIC)
MU_FIELD(CharacterAttribute, 0x190, 2, u16, REPLICATED, energy, STATIC)
MU_FIELD(CharacterAttribute, 0x192, 2, u16, REPLICATED, command, STATIC)
MU_FIELD(CharacterAttribute, 0x194, 2, u16, REPLICATED, pvp_rate, STATIC)
MU_FIELD(CharacterAttribute, 0x196, 2, u16, REPLICATED, pvp_defrate, STATIC)
MU_FIELD(CharacterAttribute, 0x198, 2, u16, REPLICATED, add_str, STATIC)
MU_FIELD(CharacterAttribute, 0x19a, 2, u16, REPLICATED, add_dex, STATIC)
MU_FIELD(CharacterAttribute, 0x19c, 2, u16, REPLICATED, add_vit, STATIC)
MU_FIELD(CharacterAttribute, 0x19e, 2, u16, REPLICATED, add_ene, STATIC)
MU_FIELD(CharacterAttribute, 0x1a4, 2, u16, REPLICATED, add_cmd, STATIC)
MU_FIELD(CharacterAttribute, 0x1ae, 8, u16, REPLICATED, add_point, STATIC)
MU_FIELD(CharacterAttribute, 0x1b8, 2, u16, REPLICATED, atk_rate, STATIC)
MU_FIELD(CharacterAttribute, 0x1ba, 2, u16, REPLICATED, dmg_min_l, STATIC)
MU_FIELD(CharacterAttribute, 0x1bc, 2, u16, REPLICATED, dmg_max_l, STATIC)
MU_FIELD(CharacterAttribute, 0x1be, 2, u16, REPLICATED, dmg_min_r, STATIC)
MU_FIELD(CharacterAttribute, 0x1c0, 2, u16, REPLICATED, dmg_max_r, STATIC)
MU_FIELD(CharacterAttribute, 0x1c4, 2, u16, REPLICATED, magic_min, STATIC)
MU_FIELD(CharacterAttribute, 0x1c6, 2, u16, REPLICATED, magic_max, STATIC)
MU_FIELD(CharacterAttribute, 0x1c8, 2, u16, REPLICATED, curse_min, STATIC)
MU_FIELD(CharacterAttribute, 0x1ca, 2, u16, REPLICATED, curse_max, STATIC)
MU_FIELD(CharacterAttribute, 0x1da, 2, u16, REPLICATED, def_rate, STATIC)
MU_FIELD(CharacterAttribute, 0x1dc, 2, u16, REPLICATED, defense, STATIC)
MU_FIELD(CharacterAttribute, 0x1e2, 2, u16, REPLICATED, points, STATIC)
MU_FIELD(CharacterAttribute, 0x1b6, 2, u16, REPLICATED, atk_speed, STATIC)
MU_FIELD(CharacterAttribute, 0x1c2, 2, u16, REPLICATED, magic_speed, STATIC)
MU_FIELD(CharacterAttribute, 0x1a6, 2, u16, REPLICATED, flags_1a6, STATIC)
MU_FIELD(CharacterAttribute, 0x1e4, 1, u8, REPLICATED, skill_count, VERIFIED)
MU_FIELD(CharacterAttribute, 0x1e6, 0x742, u16, REPLICATED, skill_ids, VERIFIED)
MU_FIELD(CharacterAttribute, 0xccc, 0xe84, i32, REPLICATED, skill_timers, VERIFIED)
/* The stat machine used by progress is separate from CharacterMachine. */
MU_RECORD(StatMachine, 0x1e4, STATIC)
MU_FIELD(StatMachine, 0x004, 4, u32, REPLICATED, owner_pointer, STATIC)
MU_FIELD(StatMachine, 0x008, 4, u32, REPLICATED, attribute_pointer, STATIC)
MU_FIELD(StatMachine, 0x1bc, 20, i32, REPLICATED, totals, STATIC)
MU_RECORD(CharacterMachine, 0x2df0, STATIC)
/* Attributes are inline at +8; the stat machine below holds the pointers. */
MU_FIELD(CharacterMachine, 0x008, 0x1b50, bytes, REPLICATED, attributes, STATIC)
MU_FIELD(CharacterMachine, 0x2d70, 4, u32, REPLICATED, money, STATIC)
MU_FIELD(CharacterMachine, 0x2d98, 4, u32, REPLICATED, stat_machine_pointer, STATIC)
MU_FIELD(CharacterMachine, 0x2ded, 1, u8, REPLICATED, mana_bonus, STATIC)
