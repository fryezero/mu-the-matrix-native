/* Scene globals are separate address-bound records, not an invented contiguous struct. */
MU_RECORD(SceneWorld, 4, STATIC)
MU_ADDRESS(SceneWorld, 0x01cf15fc)
MU_FIELD(SceneWorld, 0, 4, i32, VIEW, value, STATIC)
