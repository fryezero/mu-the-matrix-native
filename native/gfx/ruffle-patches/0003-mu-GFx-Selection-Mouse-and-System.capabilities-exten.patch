+// ---- Scaleform GFx extensions (mu patch) -----------------------------------
+//
+// One controller and one focus group, as the client plays its movies with a
+// mouse and a keyboard: focus group 0 holds controller 0 (mask 1).
+
+use crate::focus_tracker::GfxFocusOption;
+
+macro_rules! gfx_focus_option {
+    ($get:ident, $set:ident, $option:expr) => {
+        fn $get<'gc>(
+            activation: &mut Activation<'_, 'gc>,
+            _this: Object<'gc>,
+            _args: &[Value<'gc>],
+        ) -> Result<Value<'gc>, Error<'gc>> {
+            Ok(activation.context.focus_tracker.gfx_option($option).into())
+        }
+
+        fn $set<'gc>(
+            activation: &mut Activation<'_, 'gc>,
+            _this: Object<'gc>,
+            args: &[Value<'gc>],
+        ) -> Result<Value<'gc>, Error<'gc>> {
+            let value = args
+                .get(0)
+                .copied()
+                .unwrap_or(Value::Undefined)
+                .as_bool(activation.swf_version());
+            activation.context.focus_tracker.set_gfx_option($option, value);
+            Ok(Value::Undefined)
+        }
+    };
+}
+
+gfx_focus_option!(gfx_get_disable_focus_keys, gfx_set_disable_focus_keys, GfxFocusOption::DisableFocusKeys);
+gfx_focus_option!(
+    gfx_get_disable_focus_auto_release,
+    gfx_set_disable_focus_auto_release,
+    GfxFocusOption::DisableFocusAutoRelease
+);
+gfx_focus_option!(
+    gfx_get_disable_focus_rollover_event,
+    gfx_set_disable_focus_rollover_event,
+    GfxFocusOption::DisableFocusRolloverEvent
+);
+gfx_focus_option!(
+    gfx_get_always_enable_arrow_keys,
+    gfx_set_always_enable_arrow_keys,
+    GfxFocusOption::AlwaysEnableArrowKeys
+);
+
+/// `Selection.getFocusBitmask(obj)`: bit n set when controller n focuses `obj`.
+fn gfx_get_focus_bitmask<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    let Some(focus) = activation.context.focus_tracker.get() else {
+        return Ok(0.into());
+    };
+    let Some(target) = args.get(0).copied() else {
+        return Ok(0.into());
+    };
+    let start_clip = activation.target_clip_or_root();
+    let object = activation.resolve_target_display_object(start_clip, target, false)?;
+    let focused = object.is_some_and(|o| {
+        crate::display_object::DisplayObject::ptr_eq(o, focus.as_displayobject())
+    });
+    Ok(if focused { 1 } else { 0 }.into())
+}
+
+fn gfx_get_controller_mask_by_focus_group<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    let group = match args.get(0) {
+        Some(Value::Number(n)) => *n,
+        _ => 0.0,
+    };
+    Ok(if group == 0.0 { 1 } else { 0 }.into())
+}
+
+fn gfx_get_controller_focus_group<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(0.into())
+}
+
+fn gfx_set_controller_focus_group<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(false.into())
+}
+
+/// `Selection.findFocus` / `moveFocus`: directional focus search.  The client
+/// sets `disableFocusKeys`, so its movies navigate with their own handlers;
+/// no candidate is returned.
+fn gfx_find_focus<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(Value::Null)
+}
+
+fn gfx_capture_focus<'gc>(
+    _activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    Ok(Value::Undefined)
+}
