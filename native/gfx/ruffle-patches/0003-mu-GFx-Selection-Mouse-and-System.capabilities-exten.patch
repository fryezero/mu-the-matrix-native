+// ---- Scaleform GFx extensions (mu patch) -----------------------------------
+
+/// `Mouse.setCursorType(type[, mouseIndex])`: 0 arrow, 1 hand, 2 I-beam,
+/// 3 button (hand).  The host learns the shape through the UI backend.
+fn gfx_set_cursor_type<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    use crate::backend::ui::MouseCursor;
+    let kind = args.get(0).copied().unwrap_or(Value::Undefined).coerce_to_i32(activation)?;
+    let cursor = match kind {
+        1 | 3 => MouseCursor::Hand,
+        2 => MouseCursor::IBeam,
+        _ => MouseCursor::Arrow,
+    };
+    activation.context.ui.set_mouse_cursor(cursor);
+    Ok(Value::Undefined)
+}
+
+/// `Mouse.getTopMostEntity([x, y][, testAll])` (or `([testAll])`): the
+/// topmost object under the point (default: the mouse), or undefined.
+fn gfx_get_top_most_entity<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    use crate::display_object::TDisplayObject;
+    use crate::display_object::TInteractiveObject;
+    let mut point = *activation.context.mouse_position;
+    let mut test_all = true;
+    if let (Some(x), Some(y)) = (args.get(0), args.get(1))
+        && matches!(x, Value::Number(_))
+    {
+        let x = x.coerce_to_f64(activation)?;
+        let y = y.coerce_to_f64(activation)?;
+        point = crate::prelude::Point::from_pixels(x, y);
+        if let Some(v) = args.get(2) {
+            test_all = v.as_bool(activation.swf_version());
+        }
+    } else if let Some(v) = args.get(0) {
+        test_all = v.as_bool(activation.swf_version());
+    }
+    let hit = crate::player::run_mouse_pick_at(activation.context, point, !test_all);
+    Ok(hit
+        .map(|o| o.as_displayobject().object1_or_undef())
+        .unwrap_or(Value::Undefined))
+}
+
+/// `Mouse.getButtonsState([mouseIndex])`: bit 0 left, bit 1 right, bit 2 middle.
+fn gfx_get_buttons_state<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    use crate::events::MouseButton;
+    let input = &activation.context.input;
+    let mut bits = 0;
+    if input.is_mouse_down(MouseButton::Left) {
+        bits |= 1;
+    }
+    if input.is_mouse_down(MouseButton::Right) {
+        bits |= 2;
+    }
+    if input.is_mouse_down(MouseButton::Middle) {
+        bits |= 4;
+    }
+    Ok(bits.into())
+}
+
+/// `Mouse.getPosition([mouseIndex])`: a `flash.geom.Point`-like {x, y} in
+/// stage pixels.
+fn gfx_get_position<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    _this: Object<'gc>,
+    _args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    let pos = *activation.context.mouse_position;
+    let point = Object::new(&activation.context.strings, Some(activation.prototypes().object));
+    point.set(istr!("x"), Value::from(pos.x.to_pixels()), activation)?;
+    point.set(istr!("y"), Value::from(pos.y.to_pixels()), activation)?;
+    Ok(point.into())
+}
