+) -> Option<InteractiveObject<'gc>> {
+    // Scaleform GFx `topmostLevel` objects are drawn above everything else and
+    // are picked first (mu patch).
+    let mut topmost = Vec::new();
+    crate::display_object::gfx_collect_topmost(context.stage.into(), &mut topmost);
+    for obj in topmost.into_iter().rev() {
