+/// Scaleform GFx `Selection` extension properties (mu patch).
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum GfxFocusOption {
+    /// `Selection.disableFocusKeys`: Tab and the arrow keys do not move focus.
+    DisableFocusKeys = 1,
+    /// `Selection.disableFocusAutoRelease`: clicking outside a focused object
+    /// keeps its focus.
+    DisableFocusAutoRelease = 2,
+    /// `Selection.disableFocusRolloverEvent`: stored only.
+    DisableFocusRolloverEvent = 4,
+    /// `Selection.alwaysEnableArrowKeys`: stored only.
+    AlwaysEnableArrowKeys = 8,
 }
 
 #[derive(Copy, Clone)]
@@ -64,10 +80,23 @@ impl<'gc> FocusTracker<'gc> {
             FocusTrackerData {
                 focus: Lock::new(None),
                 highlight: Cell::new(Highlight::Inactive),
+                gfx_options: Cell::new(0),
             },
         ))
     }
 
+    /// A Scaleform GFx `Selection` option (mu patch).
+    pub fn gfx_option(&self, option: GfxFocusOption) -> bool {
+        self.0.gfx_options.get() & option as u8 != 0
+    }
+
+    pub fn set_gfx_option(&self, option: GfxFocusOption, value: bool) {
+        let bits = self.0.gfx_options.get();
+        self.0
+            .gfx_options
+            .set(if value { bits | option as u8 } else { bits & !(option as u8) });
+    }
+
     pub fn highlight(&self) -> Highlight {
         self.0.highlight.get()
     }
