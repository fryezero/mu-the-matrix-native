+/// Scaleform GFx extension properties stored as display object flags (mu patch).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GfxFlag {
+    HitTestDisable,
+    TopmostLevel,
+    NoAdvance,
+}
+
+impl GfxFlag {
+    fn bits(self) -> DisplayObjectFlags {
+        match self {
+            GfxFlag::HitTestDisable => DisplayObjectFlags::GFX_HIT_TEST_DISABLE,
+            GfxFlag::TopmostLevel => DisplayObjectFlags::GFX_TOPMOST_LEVEL,
+            GfxFlag::NoAdvance => DisplayObjectFlags::GFX_NO_ADVANCE,
+        }
+    }
+}
+
 bitflags! {
     /// Bit flags used by `DisplayObject`.
     #[derive(Clone, Copy)]
@@ -3065,6 +3170,18 @@ bitflags! {
         /// (they need to be instantiated "manually" by
         /// `Sprite.constructChildren`).
         const MANUAL_FRAME_CONSTRUCT  = 1 << 16;
+
+        /// Scaleform GFx `hitTestDisable` (mu patch): the object and its
+        /// children are ignored by mouse picking and hit tests.
+        const GFX_HIT_TEST_DISABLE    = 1 << 17;
+
+        /// Scaleform GFx `topmostLevel` (mu patch): the object is drawn above
+        /// every other object of the stage and picked first.
+        const GFX_TOPMOST_LEVEL       = 1 << 18;
+
+        /// Scaleform GFx `noAdvance` (mu patch): the object's timeline and its
+        /// children's do not advance.
+        const GFX_NO_ADVANCE          = 1 << 19;
     }
 }
 
