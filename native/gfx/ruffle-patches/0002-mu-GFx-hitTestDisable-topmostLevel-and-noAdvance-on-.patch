@@ -957,11 +965,65 @@ struct DrawCacheInfo {
     filters: Vec<Filter>,
 }
 
+thread_local! {
+    /// Set while the GFx `topmostLevel` objects are drawn (mu patch).
+    static GFX_TOPMOST_PASS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Visible Scaleform GFx `topmostLevel` objects below `root`, in render order
+/// (mu patch).  The subtree of a topmost object is not searched further.
+pub fn gfx_collect_topmost<'gc>(root: DisplayObject<'gc>, out: &mut Vec<DisplayObject<'gc>>) {
+    if let Some(container) = root.as_container() {
+        for child in container.iter_render_list() {
+            if !child.visible() || child.avm1_removed() {
+                continue;
+            }
+            if child.gfx_flag(GfxFlag::TopmostLevel) {
+                out.push(child);
+            } else {
+                gfx_collect_topmost(child, out);
+            }
+        }
+    }
+}
+
+/// Draw the GFx `topmostLevel` objects above the rest of the stage, each with
+/// the transforms of its ancestors (mu patch).  The normal pass skips them.
+pub fn gfx_render_topmost<'gc>(stage: DisplayObject<'gc>, context: &mut RenderContext<'_, 'gc>) {
+    let mut list = Vec::new();
+    gfx_collect_topmost(stage, &mut list);
+    if list.is_empty() {
+        return;
+    }
+    GFX_TOPMOST_PASS.with(|p| p.set(true));
+    for obj in list {
+        let mut chain = Vec::new();
+        let mut node = obj.parent();
+        while let Some(parent) = node {
+            chain.push(parent);
+            node = parent.parent();
+        }
+        for parent in chain.iter().rev() {
+            context.transform_stack.push(&parent.base().transform(true));
+        }
+        obj.render(context);
+        for _ in &chain {
+            context.transform_stack.pop();
+        }
+    }
+    GFX_TOPMOST_PASS.with(|p| p.set(false));
+}
+
 pub fn render_base<'gc>(
     this: DisplayObject<'gc>,
     context: &mut RenderContext<'_, 'gc>,
