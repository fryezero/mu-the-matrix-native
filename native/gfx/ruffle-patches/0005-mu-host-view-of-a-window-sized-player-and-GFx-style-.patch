+
     pub fn letterbox(self) -> Letterbox {
         self.0.letterbox.get()
     }
@@ -493,7 +504,14 @@ impl<'gc> Stage<'gc> {
         let viewport_size = context.renderer.viewport_dimensions();
 
         // Update stage size based on scale mode and DPI.
-        let new_stage_size = if self.0.scale_mode.get() == StageScaleMode::NoScale {
+        let gfx_view = self.0.gfx_view.get();
+        let new_stage_size = if let (Some([w, h, _, _]), StageScaleMode::NoScale) =
+            (gfx_view, self.0.scale_mode.get())
+        {
+            // mu patch: the stage keeps the host window's size while the
+            // viewport covers only a part of it.
+            (w.round() as u32, h.round() as u32)
+        } else if self.0.scale_mode.get() == StageScaleMode::NoScale {
             // Viewport size is adjusted for HiDPI.
             let width = f64::from(viewport_size.width) / viewport_size.scale_factor;
             let height = f64::from(viewport_size.height) / viewport_size.scale_factor;
@@ -562,6 +580,11 @@ impl<'gc> Stage<'gc> {
         } else {
             height_delta / 2.0
         };
+        // mu patch: shift the viewport to its part of the stage.
+        let (tx, ty) = match gfx_view {
+            Some([_, _, ox, oy]) => (tx - ox * scale_x, ty - oy * scale_y),
+            None => (tx, ty),
+        };
 
         // The viewport can be additionally translated from within the SWF header.
         let stage_tx = {
diff --git a/core/src/player.rs b/core/src/player.rs
index 3c2d2406..e54e1a54 100644
--- a/core/src/player.rs
+++ b/core/src/player.rs
@@ -992,6 +992,28 @@ impl Player {
         self.needs_render = true;
     }
 
+    /// Render only a part of the stage (mu patch): the movie keeps a
+    /// `NoScale` stage of `stage_w` x `stage_h` pixels while the viewport
+    /// (the render target) shows the area starting at (`offset_x`,
+    /// `offset_y`).  Mouse coordinates stay relative to the viewport.
+    /// `None` restores the normal view.
+    pub fn set_gfx_view(&mut self, view: Option<[f64; 4]>) {
+        self.mutate_with_update_context(|context| {
+            context.stage.set_gfx_view(view);
+            context.stage.build_matrices(context);
+        });
+        self.needs_render = true;
+    }
+
+    /// Topmost object under a viewport point, as GFx `Movie::HitTest` with
+    /// shapes (mu patch).  `None` when the point hits nothing.
+    pub fn gfx_hit_test(&mut self, x: f64, y: f64) -> bool {
+        self.mutate_with_update_context(|context| {
+            let point = context.stage.inverse_view_matrix() * Point::from_pixels(x, y);
+            run_mouse_pick_at(context, point, false).is_some()
+        })
+    }
+
