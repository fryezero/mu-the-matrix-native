         ));
@@ -216,6 +222,11 @@ impl<'gc> Stage<'gc> {
         self.0.viewport_matrix.get()
     }
 
+    /// Set the host view of a window-sized player (mu patch), see `gfx_view`.
+    pub fn set_gfx_view(self, view: Option<[f64; 4]>) {
+        self.0.gfx_view.set(view);
