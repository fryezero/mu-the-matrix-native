diff --git a/core/src/player.rs b/core/src/player.rs
index e54e1a54..ff9f89fd 100644
--- a/core/src/player.rs
+++ b/core/src/player.rs
@@ -1005,6 +1005,41 @@ impl Player {
         self.needs_render = true;
     }
 
+    /// Supply or update a host image (mu patch): straight-alpha RGBA rows,
+    /// top row first.  `BitmapData.loadBitmap(name)` in any movie of this
+    /// player returns it (sharing the pixels), as GFx returns the images a
+    /// game provides for a movie's external images.  Bitmaps the movie
+    /// already holds see the new pixels when the size is unchanged.
+    pub fn set_gfx_image(&mut self, name: &str, width: u32, height: u32, rgba: &[u8]) {
+        if width == 0 || height == 0 || rgba.len() < (width as usize) * (height as usize) * 4 {
+            return;
+        }
+        self.mutate_with_update_context(|context| {
+            use crate::bitmap::bitmap_data::{BitmapData, Color};
+            use ruffle_render::bitmap::PixelRegion;
+            let gc = context.gc();
+            let image = match context.avm1.gfx_image(name) {
+                Some(image) if image.width() == width && image.height() == height && !image.disposed() => image,
+                _ => {
+                    let image = BitmapData::new(gc, width, height, true, 0);
+                    context.avm1.set_gfx_image(name, image);
+                    image
+                }
+            };
+            let target = image.overwrite_cpu_pixels_from_gpu(gc).0;
+            let mut write = target.borrow_mut(gc);
+            for y in 0..height {
+                for x in 0..width {
+                    let i = ((y * width + x) * 4) as usize;
+                    let color = Color::rgba(rgba[i], rgba[i + 1], rgba[i + 2], rgba[i + 3]);
+                    write.set_pixel32_raw(x, y, color.to_premultiplied_alpha(true));
+                }
+            }
+            write.set_cpu_dirty(gc, PixelRegion::for_whole_size(width, height));
+        });
+        self.needs_render = true;
+    }
+
