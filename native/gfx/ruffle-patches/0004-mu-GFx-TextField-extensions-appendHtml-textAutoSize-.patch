+    "shadowColor" => value(0; DONT_ENUM);
 };
 
 pub fn create_class<'gc>(
@@ -963,3 +969,79 @@ pub fn set_style_sheet<'gc>(
     this.set_style_sheet_avm1(activation.context, style_sheet);
     Ok(())
 }
+
+// ---- Scaleform GFx extensions (mu patch) -----------------------------------
+
+/// `TextField.appendHtml(html)`: append HTML text to the field's HTML.
+fn gfx_append_html<'gc>(
+    this: EditText<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, Error<'gc>> {
+    let Some(value) = args.get(0) else {
+        return Ok(Value::Undefined);
+    };
+    let text = value.coerce_to_string(activation)?;
+    let mut html = this.html_text();
+    html.push_str(&text);
+    this.set_html_text(&html, activation.context);
+    Ok(Value::Undefined)
+}
+
+fn gfx_text_auto_size<'gc>(
+    this: EditText<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let name = match this.gfx_text_auto_size() {
+        1 => AvmString::new_utf8(activation.gc(), "shrink"),
+        2 => AvmString::new_utf8(activation.gc(), "fit"),
+        _ => AvmString::new_utf8(activation.gc(), "none"),
+    };
+    Ok(name.into())
+}
+
+fn gfx_set_text_auto_size<'gc>(
+    this: EditText<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+    value: Value<'gc>,
+) -> Result<(), Error<'gc>> {
+    let text = value.coerce_to_string(activation)?;
+    let mode = if &text == b"shrink" {
+        1
+    } else if &text == b"fit" {
+        2
+    } else {
+        0
+    };
+    this.set_gfx_text_auto_size(mode, activation.context);
+    Ok(())
+}
+
+fn gfx_vertical_align<'gc>(
+    this: EditText<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+) -> Result<Value<'gc>, Error<'gc>> {
+    let name = match this.gfx_vertical_align() {
+        1 => AvmString::new_utf8(activation.gc(), "center"),
+        2 => AvmString::new_utf8(activation.gc(), "bottom"),
+        _ => AvmString::new_utf8(activation.gc(), "none"),
+    };
+    Ok(name.into())
+}
+
+fn gfx_set_vertical_align<'gc>(
+    this: EditText<'gc>,
+    activation: &mut Activation<'_, 'gc>,
+    value: Value<'gc>,
+) -> Result<(), Error<'gc>> {
+    let text = value.coerce_to_string(activation)?;
+    let mode = if &text == b"center" {
+        1
+    } else if &text == b"bottom" {
+        2
+    } else {
+        0
+    };
+    this.set_gfx_vertical_align(mode);
+    Ok(())
+}
