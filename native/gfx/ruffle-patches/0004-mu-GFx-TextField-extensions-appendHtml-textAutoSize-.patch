     }
 
+    /// Scaleform GFx `verticalAlign` offset and `textAutoSize` scale of the
+    /// laid-out text inside the field (mu patch).
+    fn gfx_layout_adjust(self) -> Matrix {
+        let scale = self.0.gfx_layout_scale.get();
+        let valign = self.0.gfx_vertical_align.get();
+        let mut dy = Twips::ZERO;
+        if valign != 0 {
+            let avail = self.0.bounds.get().height() - Self::GUTTER * 2;
+            let text_h = self.0.layout.borrow().text_size().height().to_pixels() * scale as f64;
+            let free = avail - Twips::from_pixels(text_h);
+            if free > Twips::ZERO {
+                dy = if valign == 1 { free / 2 } else { free };
+            }
+        }
+        if scale == 1.0 && dy == Twips::ZERO {
+            return Matrix::IDENTITY;
+        }
+        Matrix::translate(Twips::ZERO, dy) * Matrix::scale(scale, scale)
+    }
+
+    /// Scaleform GFx `textAutoSize` ("none", "shrink", "fit"; mu patch).
+    pub fn gfx_text_auto_size(self) -> u8 {
+        self.0.gfx_text_auto_size.get()
+    }
+
+    pub fn set_gfx_text_auto_size(self, mode: u8, context: &mut UpdateContext<'gc>) {
+        if self.0.gfx_text_auto_size.replace(mode) != mode {
+            self.relayout(context);
+        }
+    }
+
+    /// Scaleform GFx `verticalAlign` ("none"/"top", "center", "bottom"; mu patch).
+    pub fn gfx_vertical_align(self) -> u8 {
+        self.0.gfx_vertical_align.get()
+    }
+
+    pub fn set_gfx_vertical_align(self, mode: u8) {
+        self.0.gfx_vertical_align.set(mode);
+        self.invalidate_cached_bitmap();
+    }
+
     /// Returns the matrix for transforming from this object's
     /// local space into its layout coordinate space.
     fn local_to_layout_matrix(self) -> Option<Matrix> {
@@ -894,8 +948,48 @@ impl<'gc> EditText<'gc> {
             is_word_wrap,
             font_type: self.0.font_type(),
         };
-        let new_layout =
-            html::lower_from_text_spans(&text_spans, context, layout_params, content_width);
+        let mut new_layout = html::lower_from_text_spans(
+            &text_spans,
+            context,
+            layout_params.clone(),
+            content_width,
+        );
+
+        // Scaleform GFx `textAutoSize` (mu patch): "shrink" scales the text
+        // down until it fits the field, "fit" scales it to fill the field.
+        // The text is laid out again at width / scale so that its alignment
+        // holds after scaling.
+        let mut gfx_scale = 1.0f32;
+        let gfx_mode = self.0.gfx_text_auto_size.get();
+        if gfx_mode != 0 && autosize == AutoSizeMode::None {
+            let bounds = self.0.bounds.get();
+            let avail_w = (self.local_width_to_layout_width(bounds.width()) - padding).to_pixels();
+            let avail_h = (bounds.height() - padding).to_pixels();
+            let size = new_layout.text_size();
+            let (tw, th) = (size.width().to_pixels(), size.height().to_pixels());
+            if tw > 0.0 && th > 0.0 && avail_w > 0.0 && avail_h > 0.0 {
+                let mut scale = if is_word_wrap {
+                    avail_h / th
+                } else {
+                    (avail_w / tw).min(avail_h / th)
+                };
+                if gfx_mode == 1 {
+                    scale = scale.min(1.0);
+                }
+                if (scale - 1.0).abs() > 1e-3 {
+                    gfx_scale = scale as f32;
+                    let scaled_width =
+                        content_width.map(|w| Twips::from_pixels(w.to_pixels() / scale));
+                    new_layout = html::lower_from_text_spans(
+                        &text_spans,
+                        context,
+                        layout_params,
+                        scaled_width,
+                    );
+                }
+            }
+        }
+        self.0.gfx_layout_scale.set(gfx_scale);
         drop(text_spans);
 
         unlock!(Gc::write(context.gc(), self.0), EditTextData, layout).replace(new_layout);
